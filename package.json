{
	"name": "@hevy-mcp/repository",
	"private": true,
	"description": "A Model Context Protocol (MCP) server implementation that interfaces with the Hevy fitness tracking app and its API.",
	"keywords": [
		"api",
		"exercise",
		"fitness",
		"fitness-tracker",
		"health",
		"hevy",
		"mcp",
		"model context protocol",
		"training",
		"workout",
		"workout-planner",
		"workout-tracker"
	],
	"homepage": "https://github.com/chrisdoc/hevy-mcp#readme",
	"bugs": {
		"url": "https://github.com/chrisdoc/hevy-mcp/issues"
	},
	"license": "MIT",
	"author": "Christoph Kieslich",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/chrisdoc/hevy-mcp.git"
	},
	"directories": {
		"doc": "docs",
		"test": "tests"
	},
	"workspaces": [
		"packages/*"
	],
	"type": "module",
	"scripts": {
		"prepare": "node scripts/install-git-hooks.mjs",
		"inspect": "npm run build && npx @modelcontextprotocol/inspector@latest node --env-file .env packages/node/dist/cli.mjs",
		"inspect:npm": "npx @modelcontextprotocol/inspector@latest npx hevy-mcp@latest",
		"measure:tokens": "tsx scripts/measure-token-cost.ts",
		"evaluate:usefulness": "tsx scripts/evaluate-tool-usefulness.ts",
		"test": "npm run build && node --env-file-if-exists=.env node_modules/vitest/vitest.mjs --run",
		"test:unit": "node scripts/run-validation-lane.mjs --execute unit",
		"test:release-unit": "node scripts/run-validation-lane.mjs --execute release-unit",
		"test:mcp": "node scripts/run-validation-lane.mjs --execute mocked-mcp",
		"test:contract": "node scripts/run-validation-lane.mjs --execute contract",
		"test:stdio": "node scripts/run-validation-lane.mjs --execute stdio",
		"test:worker-http": "node scripts/run-validation-lane.mjs --execute worker-http",
		"test:integration": "node scripts/run-validation-lane.mjs --execute release-integration",
		"test:worker": "node scripts/run-validation-lane.mjs --execute worker",
		"test:worker-http:live": "node scripts/run-validation-lane.mjs --execute worker-http-live",
		"test:pack": "node scripts/run-validation-lane.mjs --execute pack",
		"test:cli": "node scripts/run-validation-lane.mjs --execute cli",
		"test:pack:cli": "node scripts/run-validation-lane.mjs --execute pack-cli",
		"test:live": "node scripts/run-validation-lane.mjs --execute integration-live",
		"test:nightly": "node scripts/run-validation-lane.mjs --execute nightly",
		"test:performance": "node scripts/run-validation-lane.mjs --execute performance",
		"test:coverage": "npm run test:unit -- --coverage --coverage.reportsDirectory=coverage/unit && npm run test:mcp -- --coverage --coverage.reportsDirectory=coverage/mocked",
		"test:pr": "node scripts/run-validation-lane.mjs pull-request",
		"openapi": "node ./scripts/openapi-spec.js",
		"check:openapi": "node ./scripts/check-openapi-spec.js",
		"build": "node scripts/run-validation-lane.mjs --execute build",
		"build:standalone": "npm run build:standalone --workspace hevy-mcp",
		"build:client": "npm run build:client --workspace @hevy-mcp/hevy-client && npx prettier --ignore-unknown --write packages/hevy-client/src/generated",
		"prepack": "npm run check:server-manifest && npm run build",
		"start": "node --env-file .env packages/node/dist/cli.mjs",
		"dev": "tsx watch --env-file .env --clear-screen=false packages/node/src/cli.ts",
		"check": "node scripts/run-validation-lane.mjs check",
		"check:repository": "node scripts/run-validation-lane.mjs --execute check",
		"check:fix": "oxlint . --type-aware --type-check && oxfmt . --write",
		"check:types": "node scripts/run-validation-lane.mjs --execute types",
		"check:workspaces": "node scripts/run-validation-lane.mjs --execute workspace-topology",
		"check:boundaries": "node scripts/run-validation-lane.mjs --execute package-boundaries",
		"check:exports": "node scripts/run-validation-lane.mjs --execute package-exports",
		"check:release-candidates": "node scripts/run-validation-lane.mjs --execute release-candidates",
		"check:package-changesets": "node scripts/run-validation-lane.mjs --execute package-changesets",
		"check:control-plane": "node scripts/check-control-plane.mjs",
		"build:packages": "npm run build --workspaces --if-present",
		"check:changeset": "node scripts/run-validation-lane.mjs --execute changeset-status",
		"check:server-manifest": "node scripts/run-validation-lane.mjs --execute server-manifest",
		"validate:lane": "node scripts/run-validation-lane.mjs",
		"sync:server-manifest": "node scripts/server-manifest.mjs sync",
		"version:changesets": "changeset version && npm run sync:server-manifest",
		"version": "npm run sync:server-manifest && git add server.json packages/node/server.json",
		"version:patch": "npm version patch",
		"version:minor": "npm version minor",
		"version:major": "npm version major",
		"release": "changeset publish",
		"commit": "commit",
		"worker:dev": "wrangler dev --x-new-config",
		"worker:deploy": "cross-env WRANGLER_MODE=production wrangler deploy --x-new-config --env production",
		"worker:dry-run": "node scripts/run-validation-lane.mjs --execute worker-bundle"
	},
	"devDependencies": {
		"@changesets/changelog-github": "^0.7.0",
		"@changesets/cli": "^2.31.1",
		"@cloudflare/vitest-pool-workers": "^0.19.1",
		"@cloudflare/workers-oauth-provider": "^0.8.2",
		"@codecov/rollup-plugin": "^2.0.1",
		"@commitlint/cli": "^21.2.1",
		"@commitlint/config-conventional": "^21.2.0",
		"@commitlint/prompt-cli": "^21.2.0",
		"@kubb/cli": "^4.39.2",
		"@kubb/core": "^4.39.2",
		"@kubb/plugin-client": "^4.39.2",
		"@kubb/plugin-faker": "^4.39.2",
		"@kubb/plugin-oas": "^4.39.2",
		"@kubb/plugin-ts": "^4.39.2",
		"@kubb/plugin-zod": "^4.39.2",
		"@modelcontextprotocol/client": "^2.0.0",
		"@modelcontextprotocol/server": "^2.0.0",
		"@opentelemetry/api": "^1.9.1",
		"@opentelemetry/exporter-metrics-otlp-http": "^0.221.0",
		"@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
		"@opentelemetry/resources": "^2.10.0",
		"@opentelemetry/sdk-metrics": "^2.10.0",
		"@opentelemetry/sdk-trace-base": "^2.10.0",
		"@opentelemetry/sdk-trace-node": "^2.10.0",
		"@sentry/node": "^10.68.0",
		"@sentry/opentelemetry": "^10.68.0",
		"@sentry/rollup-plugin": "^5.4.0",
		"@types/node": "^26.1.2",
		"@types/semver": "^7.7.1",
		"@vitest/coverage-v8": "^4.1.10",
		"abstract-syntax-tree": "^2.24.0",
		"cross-env": "^10.1.0",
		"js-yaml": "^4.3.1",
		"nock": "^14.0.17",
		"oxfmt": "^0.61.0",
		"oxlint": "^1.76.0",
		"oxlint-tsgolint": "^7.0.2001",
		"semver": "^7.8.5",
		"tiktoken": "^1.0.22",
		"tsdown": "^0.22.14",
		"tsx": "^4.23.1",
		"typescript": "^7.0.2",
		"vitest": "^4.1.10",
		"wrangler": "^4.114.0",
		"zod": "^4.4.3"
	},
	"engines": {
		"node": ">=20.0.0"
	},
	"allowScripts": {
		"@sentry/cli@2.58.6": true,
		"es5-ext@0.10.64": true,
		"esbuild@0.28.1": true,
		"fsevents@2.3.3": true,
		"workerd@1.20260722.1": true
	},
	"mcpName": "io.github.chrisdoc/hevy-mcp"
}
