{
	"$schema": "./node_modules/nx/schemas/project-schema.json",
	"name": "repository",
	"root": ".",
	"projectType": "library",
	"tags": ["runtime:neutral", "publishability:private", "role:control-plane"],
	"targets": {
		"check:workspaces": {
			"inputs": ["controlPlaneInputs"]
		},
		"check:boundaries": {
			"inputs": ["sourceInputs", "controlPlaneInputs"]
		},
		"check:exports": {
			"inputs": ["packageManifestInputs", "controlPlaneInputs"]
		},
		"check:release-candidates": {
			"inputs": ["packageManifestInputs", "controlPlaneInputs"]
		},
		"check:package-changesets": {
			"cache": false,
			"inputs": ["packageManifestInputs", "{workspaceRoot}/.changeset/**/*.md"]
		},
		"check:types": {
			"inputs": ["validationInputs"]
		},
		"check": {
			"inputs": ["sourceInputs", "controlPlaneInputs"]
		},
		"check:server-manifest": {
			"inputs": ["validationInputs"]
		},
		"check:changeset": {
			"cache": false,
			"inputs": ["packageManifestInputs", "{workspaceRoot}/.changeset/**/*.md"]
		},
		"test:pr": {
			"executor": "nx:noop",
			"dependsOn": [
				"test:unit",
				"test:mcp",
				"test:contract",
				"test:stdio",
				"test:worker",
				"test:worker-http",
				"test:pack",
				"test:cli",
				"test:pack:cli"
			],
			"inputs": ["validationInputs"]
		},
		"test:unit": {
			"cache": true,
			"inputs": ["validationInputs"],
			"outputs": [
				"{workspaceRoot}/coverage/unit",
				"{workspaceRoot}/test-results/unit-tests.xml"
			]
		},
		"test:mcp": {
			"cache": true,
			"inputs": ["validationInputs"],
			"outputs": ["{workspaceRoot}/coverage/mocked"]
		},
		"test:integration": {
			"cache": false,
			"inputs": ["validationInputs"]
		},
		"test:diagnostics": {
			"cache": false,
			"inputs": ["validationInputs"]
		},
		"test:contract": {
			"cache": true,
			"inputs": ["validationInputs"]
		},
		"test:stdio": {
			"cache": true,
			"inputs": ["validationInputs"]
		},
		"test:worker": {
			"cache": false,
			"parallelism": false,
			"inputs": ["validationInputs"]
		},
		"test:worker-http": {
			"cache": false,
			"parallelism": false,
			"inputs": ["validationInputs"]
		},
		"test:pack": {
			"cache": false,
			"parallelism": false,
			"inputs": ["validationInputs"]
		},
		"test:cli": {
			"cache": true,
			"inputs": ["validationInputs"]
		},
		"test:pack:cli": {
			"cache": false,
			"dependsOn": ["test:pack"],
			"options": { "env": { "FORCE_COLOR": "0" } },
			"parallelism": false,
			"inputs": ["validationInputs"]
		},
		"test:nightly": {
			"cache": false,
			"inputs": ["validationInputs"]
		},
		"test:live": {
			"cache": false,
			"inputs": ["validationInputs"]
		},
		"test:worker-http:live": {
			"cache": false,
			"inputs": ["validationInputs"]
		},
		"measure:tokens": {
			"cache": false,
			"inputs": ["validationInputs"]
		},
		"worker:dry-run": {
			"cache": false,
			"inputs": ["validationInputs"],
			"outputs": ["{workspaceRoot}/.wrangler/dry-run"]
		},
		"build": {
			"outputs": ["{workspaceRoot}/packages/node/dist"],
			"inputs": ["validationInputs"]
		},
		"build:client": {
			"outputs": ["{workspaceRoot}/packages/hevy-client/src/generated"],
			"inputs": [
				"{workspaceRoot}/openapi-spec.json",
				"{workspaceRoot}/packages/hevy-client/kubb.config.ts",
				"{workspaceRoot}/packages/hevy-client/package.json",
				"controlPlaneInputs"
			]
		},
		"sync:server-manifest": {
			"cache": false,
			"outputs": [
				"{workspaceRoot}/server.json",
				"{workspaceRoot}/plugin.json",
				"{workspaceRoot}/packages/node/server.json"
			],
			"inputs": [
				"{workspaceRoot}/server.json",
				"{workspaceRoot}/plugin.json",
				"{workspaceRoot}/packages/node/package.json",
				"{workspaceRoot}/scripts/server-manifest.mjs"
			]
		},
		"test:coverage": {
			"cache": false,
			"outputs": [
				"{workspaceRoot}/coverage/unit",
				"{workspaceRoot}/coverage/mocked"
			],
			"inputs": ["validationInputs"]
		},
		"test:performance": {
			"cache": false,
			"outputs": ["{workspaceRoot}/test-results/performance/summary.json"],
			"inputs": ["validationInputs"]
		},
		"pack:artifacts": {
			"executor": "nx:run-commands",
			"cache": false,
			"dependsOn": ["hevy-mcp:build", "@chrisdoc/hevy-cli:build"],
			"options": {
				"command": "mkdir -p .nx/pack && npm pack --workspace=hevy-mcp --workspace=@chrisdoc/hevy-cli --pack-destination .nx/pack --ignore-scripts --silent"
			},
			"outputs": ["{workspaceRoot}/.nx/pack/*.tgz"],
			"inputs": ["validationInputs"]
		},
		"dependency-cruiser": {
			"executor": "nx:run-commands",
			"options": { "command": "npm run check:dependency-cruiser" },
			"inputs": ["validationInputs"]
		},
		"version:changesets": {
			"cache": false,
			"inputs": ["packageManifestInputs", "{workspaceRoot}/.changeset/**/*.md"]
		},
		"version": {
			"cache": false,
			"inputs": ["packageManifestInputs", "controlPlaneInputs"]
		},
		"version:major": { "cache": false },
		"version:minor": { "cache": false },
		"version:patch": { "cache": false },
		"release": {
			"cache": false,
			"inputs": ["packageManifestInputs", "controlPlaneInputs"]
		},
		"worker:deploy": { "cache": false },
		"control-plane": {
			"dependsOn": [
				"check:workspaces",
				"check:boundaries",
				"check:exports",
				"test:pr",
				"check:server-manifest",
				"check",
				"check:types",
				"check:changeset"
			],
			"inputs": ["validationInputs"]
		}
	}
}
