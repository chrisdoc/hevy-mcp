{
	"name": "@chrisdoc/hevy-cli",
	"version": "1.2.6",
	"description": "Command-line client for the Hevy API",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/chrisdoc/hevy-mcp"
	},
	"bin": {
