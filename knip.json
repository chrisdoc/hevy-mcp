{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"workspaces": {
		".": {
			"entry": [
				".agents/daemons/pr-merge-conflict-repair/scripts/find-conflicted-pulls.ts",
				".pi/extensions/entire/index.ts",
				".github/workers/preview-bootstrap.ts",
				"cloudflare.config.ts",
				"scripts/check-candidate-publint.mjs",
				"scripts/testing/collect-validation-lane-inventory.mjs",
				"scripts/testing/cli-safe-validation.mjs",
				"scripts/pack-release-candidates.mjs",
				"scripts/testing/run-integration-vitest.mjs",
				"scripts/testing/run-live-vitest.mjs",
				"scripts/testing/run-vitest-lane.mjs",
				"tests/package/npm-pack-smoke.mjs",
				"tests/performance/child-fixture.mjs",
				"vitest.workers.config.ts"
			],
			"ignoreDependencies": ["@earendil-works/pi-coding-agent", "cloudflare"]
		},
		"packages/worker": {
			"ignoreDependencies": ["cloudflare"]
		},
		"packages/hevy-client": {
			"entry": ["kubb.config.ts"],
			"ignoreIssues": {
				"src/fetch.ts": ["duplicates"],
				"src/internal-request-effect.ts": ["duplicates"]
			}
		},
		"packages/operations": {
			"ignoreIssues": {
				"src/workflows.ts": ["duplicates"]
			}
		},
		"packages/cli": {
			"entry": ["tests/npm-pack-smoke.mjs"]
		}
	},
	"ignoreBinaries": ["mise"],
	"ignore": ["packages/hevy-client/src/generated/**"],
	"ignoreFiles": [
		"tests/fixtures/**",
		"scripts/codegen/check-generated-client.d.mts",
		"scripts/check-package-boundaries.d.mts",
		"scripts/check-package-changesets.d.mts",
		"scripts/release-candidate-artifacts.d.mts",
		"scripts/release-outputs.d.mts",
		"scripts/resolve-worker-version.d.mts",
		"scripts/runtime-value-predicates.d.mts",
		"scripts/server-manifest.d.mts",
		"scripts/workflow-projections.d.mts"
	]
}
