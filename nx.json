{
	"$schema": "./node_modules/nx/schemas/nx-schema.json",
	"namedInputs": {
		"nodeMajor": [
			{
				"runtime": "node -e 'process.stdout.write(process.versions.node.split(\".\")[0])'"
			}
		],
		"repositoryConfig": [
			"{workspaceRoot}/nx.json",
			"{workspaceRoot}/project.json",
			"{workspaceRoot}/package.json",
			"{workspaceRoot}/pnpm-lock.yaml",
			"{workspaceRoot}/tsconfig*.json",
			"{workspaceRoot}/vitest*.config.*",
			"{workspaceRoot}/oxlint.config.ts",
			"{workspaceRoot}/oxfmt.config.ts"
		],
		"controlPlaneInputs": [
			"{workspaceRoot}/.nvmrc",
			"{workspaceRoot}/nx.json",
			"{workspaceRoot}/project.json",
			"{workspaceRoot}/package.json",
			"{workspaceRoot}/pnpm-lock.yaml",
			"{workspaceRoot}/packages/*/package.json",
			"{workspaceRoot}/.github/workflows/build-and-test.yml",
			"{workspaceRoot}/.github/workflows/release.yml",
			"{workspaceRoot}/scripts/**/*.mjs",
			"{workspaceRoot}/scripts/**/*.cjs",
			"{workspaceRoot}/.dependency-cruiser.cjs",
			"controlPlaneModels"
		],
		"packageManifestInputs": [
			"{workspaceRoot}/package.json",
			"{workspaceRoot}/pnpm-lock.yaml",
			"{workspaceRoot}/packages/*/package.json"
		],
		"packageConfigs": [
			"packageManifestInputs",
			"{workspaceRoot}/packages/*/tsconfig*.json",
			"{workspaceRoot}/packages/*/tsdown.config.*",
			"{workspaceRoot}/packages/hevy-client/kubb.config.ts"
		],
		"projectSources": ["{projectRoot}/src/**/*"],
		"projectConfigs": [
			"{projectRoot}/package.json",
			"{projectRoot}/tsconfig*.json",
			"{projectRoot}/tsdown.config.*",
			"{projectRoot}/kubb.config.ts"
		],
		"projectSharedConfigs": [
			"{workspaceRoot}/pnpm-lock.yaml",
			"{workspaceRoot}/tsconfig*.json"
		],
		"projectTypeCheckInputs": [
			"projectConfigs",
			"projectSharedConfigs",
			"projectSources"
		],
		"compilerConfigs": [
			"{workspaceRoot}/tsconfig*.json",
			"{workspaceRoot}/packages/*/tsconfig*.json"
		],
		"rootSources": [
			"{workspaceRoot}/*.ts",
			"{workspaceRoot}/scripts/**/*.ts",
			"{workspaceRoot}/scripts/**/*.mts",
			"{workspaceRoot}/scripts/**/*.cts",
			"{workspaceRoot}/tests/**/*.ts",
			"{workspaceRoot}/tests/**/*.tsx"
		],
		"runtimeSources": ["{workspaceRoot}/packages/*/src/**/*"],
		"testFixtures": ["{workspaceRoot}/tests/fixtures/**/*"],
		"testShims": ["{workspaceRoot}/tests/shims/**/*"],
		"testScripts": ["{workspaceRoot}/scripts/**/*"],
		"controlPlaneModels": ["{workspaceRoot}/repository/**/*"],
		"unitSpecialInputs": [
			"{workspaceRoot}/.dependency-cruiser.cjs",
			"{workspaceRoot}/.cm/plugins/filters/findDiffLocation/index.js",
			"{workspaceRoot}/packages/node/README.md"
		],
		"unitTests": [
			"nodeMajor",
			"repositoryConfig",
			"packageConfigs",
			"runtimeSources",
			"testFixtures",
			"testScripts",
			"controlPlaneModels",
			"{workspaceRoot}/tests/unit/**/*",
			"unitSpecialInputs"
		],
		"releaseUnitTests": [
			"nodeMajor",
			"repositoryConfig",
			"packageConfigs",
			"runtimeSources",
			"testFixtures",
			"testScripts",
			"controlPlaneModels",
			"{workspaceRoot}/tests/**/*",
			"unitSpecialInputs"
		],
		"generatedClientInputs": [
			"repositoryConfig",
			"packageConfigs",
			"controlPlaneModels",
			"openapiInputs",
			"{workspaceRoot}/scripts/check-generated-client.mjs",
			"{workspaceRoot}/scripts/check-generated-client.d.mts",
			"{workspaceRoot}/scripts/check-generated-client.test.ts",
			"{workspaceRoot}/scripts/openapi-spec.js",
			"{workspaceRoot}/tests/fixtures/generated-client/**/*",
			"{workspaceRoot}/packages/hevy-client/src/generated/**/*",
			"{workspaceRoot}/packages/hevy-client/src/types.ts",
			"{workspaceRoot}/packages/hevy-client/src/schemas.ts"
		],
		"mockedTests": [
			"nodeMajor",
			"repositoryConfig",
			"packageConfigs",
			"runtimeSources",
			"testShims",
			"{workspaceRoot}/tests/integration/mocked/**/*"
		],
		"contractTests": [
			"nodeMajor",
			"repositoryConfig",
			"packageConfigs",
			"testFixtures",
			"manifestInputs",
			"{workspaceRoot}/packages/node/src/**/*",
			"{workspaceRoot}/packages/core/src/**/*",
			"{workspaceRoot}/packages/hevy-client/src/**/*",
			"{workspaceRoot}/packages/operations/src/**/*",
			"{workspaceRoot}/tests/contract/**/*",
			"{workspaceRoot}/tests/unit/server-manifest.test.ts"
		],
		"stdioTests": [
			"nodeMajor",
			"repositoryConfig",
			"packageConfigs",
			"compilerConfigs",
			"{workspaceRoot}/packages/node/src/**/*",
			"{workspaceRoot}/packages/core/src/**/*",
			"{workspaceRoot}/packages/hevy-client/src/**/*",
			"{workspaceRoot}/packages/operations/src/**/*",
			"{workspaceRoot}/tests/fixtures/graceful-shutdown-child.ts"
		],
		"cliTests": [
			"nodeMajor",
			"repositoryConfig",
			"packageConfigs",
			"{workspaceRoot}/packages/cli/src/**/*",
			"{workspaceRoot}/packages/core/src/**/*",
			"{workspaceRoot}/packages/hevy-client/src/**/*",
			"{workspaceRoot}/packages/operations/src/**/*"
		],
		"repositoryTypeCheckInputs": [
			"nodeMajor",
			"compilerConfigs",
			"packageManifestInputs",
			"runtimeSources",
			"rootSources"
		],
		"packageBuildInputs": ["projectTypeCheckInputs"],
		"repositoryBuildInputs": [
			"packageConfigs",
			"compilerConfigs",
			"runtimeSources"
		],
		"nodeBuildInputs": ["packageBuildInputs", "{projectRoot}/tsdown.config.ts"],
		"repositoryNodeBuildInputs": [
			"repositoryBuildInputs",
			"{workspaceRoot}/packages/node/tsdown.config.ts"
		],
		"cliBuildInputs": ["packageBuildInputs", "{projectRoot}/tsdown.config.ts"],
		"manifestInputs": [
			"controlPlaneModels",
			"{workspaceRoot}/package.json",
			"{workspaceRoot}/server.json",
			"{workspaceRoot}/plugin.json",
			"{workspaceRoot}/packages/node/server.json",
			"{workspaceRoot}/packages/node/package.json",
			"{workspaceRoot}/scripts/server-manifest.mjs",
			"{workspaceRoot}/scripts/repository-control-plane.mjs",
			"{workspaceRoot}/scripts/control-plane-models.mjs"
		],
		"openapiInputs": [
			"{workspaceRoot}/openapi-spec.json",
			"{workspaceRoot}/packages/hevy-client/kubb.config.ts",
			"{workspaceRoot}/packages/hevy-client/package.json",
			"{workspaceRoot}/pnpm-lock.yaml"
		],
		"boundaryInputs": [
			"runtimeSources",
			"compilerConfigs",
			"{workspaceRoot}/.dependency-cruiser.cjs",
			"{workspaceRoot}/scripts/check-package-boundaries.mjs"
		],
		"validationInputs": [
			"repositoryConfig",
			"packageConfigs",
			"runtimeSources",
			"testFixtures",
			"testScripts",
			"packageManifestInputs",
			"controlPlaneInputs"
		],
		"clientGenerationInputs": ["openapiInputs", "{workspaceRoot}/package.json"],
		"openapiCheckInputs": [
			"openapiInputs",
			"controlPlaneModels",
			"{workspaceRoot}/scripts/check-openapi-spec.js",
			"{workspaceRoot}/scripts/openapi-spec.js",
			"{workspaceRoot}/scripts/repository-control-plane.mjs",
			"{workspaceRoot}/scripts/control-plane-models.mjs",
			"{workspaceRoot}/scripts/control-plane-validation.mjs"
		],
		"workerTests": [
			"nodeMajor",
			"repositoryConfig",
			"packageConfigs",
			"{workspaceRoot}/packages/worker/src/**/*",
			"{workspaceRoot}/packages/core/src/**/*",
			"{workspaceRoot}/packages/hevy-client/src/**/*",
			"{workspaceRoot}/packages/operations/src/**/*",
			"{workspaceRoot}/tests/cloudflare/**/*",
			"{workspaceRoot}/wrangler.test.jsonc"
		]
	},
	"plugins": ["./scripts/nx-project-metadata.cjs"],
	"targetDefaults": {
		"build": [
			{
				"cache": true,
				"inputs": ["packageBuildInputs"],
				"dependsOn": ["^check:types"]
			},
			{
				"cache": true,
				"inputs": ["cliBuildInputs"],
				"filter": { "projects": ["@chrisdoc/hevy-cli"] }
			},
			{
				"cache": false,
				"inputs": ["nodeBuildInputs"],
				"filter": { "projects": ["hevy-mcp"] }
			}
		],
		"check:types": {
			"cache": true,
			"inputs": ["projectTypeCheckInputs"],
			"dependsOn": ["^check:types"]
		}
	}
}
