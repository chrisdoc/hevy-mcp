			"nxTarget": "test:pr",
			"mappingStatus": "mapped"
		},
		"pull-request-ci": {
			"external": true,
			"lanes": [
				"repository-control-plane",
				"package-boundaries",
				"package-exports",
				"package-publint",
				"types",
				"server-manifest",
				"check",
				"package-changesets",
