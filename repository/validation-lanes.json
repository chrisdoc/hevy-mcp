{
	"version": 1,
	"runtimeMatrix": {
		"node-24": {
			"kind": "node",
			"version": "24.x"
		},
		"node-26": {
			"kind": "node",
			"version": "26.x"
		},
		"workerd": {
			"kind": "workerd",
			"version": "wrangler-local"
		}
	},
	"lanes": [
		{
			"id": "unit",
			"alias": "test:unit",
			"selector": {
				"kind": "vitest",
				"exclude": ["tests/integration/**", "tests/performance/**"]
			},
			"runtimes": ["node-24", "node-26"],
			"credentials": [],
			"artifacts": ["unit-coverage", "unit-junit"],
			"gate": "blocking",
			"comparison": "coverage-report",
			"changeImpact": ["packages/**/src/**", "tests/unit/**", "scripts/**"],
			"nxTarget": "test:unit",
			"mappingStatus": "mapped"
		},
		{
			"id": "release-unit",
			"alias": "test:release-unit",
			"selector": {
				"kind": "vitest",
				"exclude": ["tests/integration/**"]
			},
			"runtimes": ["node-24", "node-26"],
			"credentials": [],
			"artifacts": ["unit-coverage", "unit-junit"],
			"gate": "blocking",
			"comparison": "release-suite",
			"changeImpact": ["packages/**/src/**", "tests/unit/**", "scripts/**"],
			"nxTarget": "test:release-unit",
			"mappingStatus": "mapped"
		},
		{
			"id": "mocked-mcp",
			"alias": "test:mcp",
			"selector": {
				"kind": "vitest",
				"include": ["tests/integration/mocked/**"]
			},
			"runtimes": ["node-24", "node-26"],
			"credentials": [],
			"artifacts": ["mocked-coverage"],
			"gate": "blocking",
			"comparison": "coverage-report",
			"changeImpact": ["packages/**/src/**", "tests/integration/mocked/**"],
			"nxTarget": "test:mcp",
			"mappingStatus": "mapped"
		},
		{
			"id": "contract",
			"alias": "test:contract",
			"selector": {
				"kind": "vitest",
				"include": [
					"packages/node/src/index.test.ts",
					"packages/node/src/utils/config.test.ts",
					"packages/core/src/tools/register.test.ts",
					"packages/core/src/utils/output-schemas.test.ts",
					"tests/unit/server-manifest.test.ts"
				]
			},
			"runtimes": ["node-24"],
			"credentials": [],
			"artifacts": [],
			"gate": "blocking",
			"comparison": "contract",
			"changeImpact": [
				"packages/core/**",
				"packages/node/**",
				"tests/unit/server-manifest.test.ts"
			],
			"nxTarget": "test:contract",
			"mappingStatus": "mapped"
		},
		{
			"id": "stdio",
			"alias": "test:stdio",
			"selector": {
				"kind": "vitest",
				"include": [
					"packages/node/src/index.test.ts",
					"packages/node/src/utils/stdio-observability.test.ts",
					"packages/node/src/utils/graceful-shutdown.test.ts",
					"packages/node/src/utils/graceful-shutdown.child-process.test.ts"
				]
			},
			"runtimes": ["node-24"],
			"credentials": [],
			"artifacts": ["stdio-diagnostics"],
			"gate": "blocking",
			"comparison": "protocol",
			"changeImpact": ["packages/node/src/**", "packages/core/src/**"],
			"nxTarget": "test:stdio",
			"mappingStatus": "mapped"
		},
		{
			"id": "worker",
			"alias": "test:worker",
			"selector": {
				"kind": "vitest-worker-config",
				"config": "vitest.workers.config.ts"
			},
			"runtimes": ["workerd"],
			"credentials": [],
			"artifacts": [],
			"gate": "blocking",
			"comparison": "worker-contract",
			"changeImpact": [
				"packages/worker/**",
				"packages/core/**",
				"cloudflare.config.ts"
			],
			"nxTarget": "test:worker",
			"mappingStatus": "mapped"
		},
		{
			"id": "worker-http",
			"alias": "test:worker-http",
			"selector": {
				"kind": "vitest",
				"include": ["tests/integration/worker-http.integration.test.ts"]
			},
			"runtimes": ["workerd"],
			"workflowRuntimes": ["node-24"],
			"credentials": [],
			"artifacts": [],
			"gate": "blocking",
			"comparison": "worker-http-contract",
			"changeImpact": [
				"packages/worker/**",
				"packages/core/**",
				"tests/integration/worker-http.integration.test.ts"
			],
			"nxTarget": "test:worker-http",
			"mappingStatus": "mapped"
		},
		{
			"id": "pack",
			"alias": "test:pack",
			"selector": {
				"kind": "npm-pack-smoke"
			},
			"runtimes": ["node-24"],
			"credentials": [],
			"artifacts": ["node-package-tarball"],
			"gate": "blocking",
			"comparison": "candidate-artifact",
			"changeImpact": [
				"packages/node/**",
				"server.json",
				"plugin.json",
				"Dockerfile"
			],
			"nxTarget": "test:pack",
			"mappingStatus": "mapped"
		},
		{
			"id": "cli",
			"alias": "test:cli",
			"selector": {
				"kind": "workspace-test",
				"workspace": "@chrisdoc/hevy-cli"
			},
			"runtimes": ["node-24"],
			"credentials": [],
			"artifacts": ["cli-dist"],
			"gate": "blocking",
			"comparison": "cli-contract",
			"changeImpact": [
				"packages/cli/**",
				"packages/core/**",
				"packages/hevy-client/**"
			],
			"nxTarget": "test:cli",
			"mappingStatus": "mapped"
		},
		{
			"id": "pack-cli",
			"alias": "test:pack:cli",
			"selector": {
				"kind": "npm-pack-smoke",
				"workspace": "@chrisdoc/hevy-cli"
			},
			"runtimes": ["node-24"],
			"credentials": [],
			"artifacts": ["cli-package-tarball"],
			"gate": "blocking",
			"comparison": "candidate-artifact",
			"changeImpact": ["packages/cli/**"],
			"nxTarget": "test:pack:cli",
			"mappingStatus": "mapped"
		},
		{
			"id": "performance",
			"alias": "test:performance",
			"selector": {
				"kind": "vitest",
				"include": ["tests/performance/performance.test.ts"]
			},
			"runtimes": ["node-24"],
			"credentials": [],
			"artifacts": ["performance-summary"],
			"gate": "informational",
			"comparison": "performance-baseline",
			"changeImpact": ["packages/**/src/**", "tests/performance/**"],
			"nxTarget": "test:performance",
			"mappingStatus": "mapped"
		},
		{
			"id": "repository-control-plane",
			"alias": "check:control-plane",
			"selector": {
				"kind": "control-plane",
				"check": "control-plane"
			},
			"runtimes": ["node-24", "node-26"],
			"credentials": [],
			"artifacts": [],
			"gate": "blocking",
			"comparison": "control-plane",
			"changeImpact": [
				"repository/**",
				"scripts/control-plane-*.mjs",
				"project.json",
				"nx.json"
			],
			"nxTarget": "check:control-plane",
			"mappingStatus": "mapped"
		},
		{
			"id": "workspace-topology",
			"alias": "check:workspaces",
			"selector": {
				"kind": "control-plane",
				"check": "topology"
			},
			"runtimes": ["node-24", "node-26"],
			"credentials": [],
			"artifacts": [],
			"gate": "blocking",
			"comparison": "topology",
			"changeImpact": [
				"package.json",
				"packages/*/package.json",
				"repository/topology.json"
			],
			"nxTarget": "check:workspaces",
			"mappingStatus": "mapped"
		},
		{
			"id": "package-boundaries",
			"alias": "check:boundaries",
			"selector": {
				"kind": "control-plane",
				"check": "boundaries"
			},
			"runtimes": ["node-24", "node-26"],
			"credentials": [],
			"artifacts": [],
			"gate": "blocking",
			"comparison": "dependency-graph",
			"changeImpact": ["packages/**/src/**", "repository/topology.json"],
			"nxTarget": "check:boundaries",
			"mappingStatus": "mapped"
		},
		{
			"id": "package-exports",
			"alias": "check:exports",
			"selector": {
				"kind": "control-plane",
				"check": "exports"
			},
			"runtimes": ["node-24", "node-26"],
			"credentials": [],
			"artifacts": [],
			"gate": "blocking",
			"comparison": "exports",
			"changeImpact": ["packages/*/package.json", "repository/topology.json"],
			"nxTarget": "check:exports",
			"mappingStatus": "mapped"
		},
		{
			"id": "release-candidates",
			"alias": "check:release-candidates",
			"selector": {
				"kind": "control-plane",
				"check": "release-candidates"
			},
			"runtimes": ["node-24", "node-26"],
			"credentials": [],
			"artifacts": [],
			"gate": "blocking",
			"comparison": "publishability",
			"changeImpact": ["packages/*/package.json", "repository/topology.json"],
			"nxTarget": "check:release-candidates",
			"mappingStatus": "mapped"
		},
		{
			"id": "package-changesets",
			"alias": "check:package-changesets",
			"selector": {
				"kind": "control-plane",
				"check": "changesets"
			},
			"runtimes": ["node-24"],
			"credentials": [],
			"artifacts": [],
			"gate": "blocking",
			"comparison": "release-cascade",
			"changeImpact": [
				"packages/**",
				"cloudflare.config.ts",
				".changeset/**",
				"repository/topology.json"
			],
			"nxTarget": "check:package-changesets",
			"mappingStatus": "mapped"
		},
		{
			"id": "changeset-status",
			"alias": "check:changeset",
			"selector": {
				"kind": "changeset-status"
			},
			"runtimes": ["node-24"],
			"credentials": [],
			"artifacts": [],
			"gate": "blocking",
			"comparison": "release-cascade",
			"changeImpact": [
				".changeset/**",
				"packages/**",
				"cloudflare.config.ts",
				"repository/topology.json"
			],
			"nxTarget": "check:changeset",
			"mappingStatus": "mapped"
		},
		{
			"id": "types",
			"alias": "check:types",
			"selector": {
				"kind": "typescript",
				"project": "tsconfig.json"
			},
			"runtimes": ["node-24", "node-26"],
			"credentials": [],
			"artifacts": [],
			"gate": "blocking",
			"comparison": "type-safety",
			"changeImpact": ["packages/**", "scripts/**", "tests/**"],
			"nxTarget": "check:types",
			"mappingStatus": "mapped"
		},
		{
			"id": "check",
			"selector": {
				"kind": "repository-check"
			},
			"runtimes": ["node-24", "node-26"],
			"credentials": [],
			"artifacts": [],
			"gate": "blocking",
			"comparison": "style-and-static",
			"changeImpact": ["**/*"],
			"nxTarget": "check",
			"mappingStatus": "mapped"
		},
		{
			"id": "build",
			"alias": "build",
			"selector": {
				"kind": "package-build",
				"workspace": "hevy-mcp"
			},
			"runtimes": ["node-24", "node-26"],
			"credentials": [],
			"artifacts": ["node-dist", "node-package-tarball"],
			"gate": "blocking",
			"comparison": "build-output",
			"changeImpact": [
				"packages/**",
				"openapi-spec.json",
				"repository/artifact-provenance.json"
			],
			"nxTarget": "build",
			"mappingStatus": "mapped"
		},
		{
			"id": "worker-bundle",
			"alias": "worker:dry-run",
			"selector": {
				"kind": "wrangler-dry-run"
			},
			"runtimes": ["workerd"],
			"workflowRuntimes": ["node-24"],
			"credentials": [],
			"artifacts": ["worker-bundle"],
			"gate": "blocking",
			"comparison": "bundle-closure",
			"changeImpact": [
				"packages/worker/**",
				"packages/core/**",
				"packages/hevy-client/**",
				"cloudflare.config.ts"
			],
			"nxTarget": "worker:dry-run",
			"mappingStatus": "mapped"
		},
		{
			"id": "server-manifest",
			"alias": "check:server-manifest",
			"selector": {
				"kind": "manifest-drift"
			},
			"runtimes": ["node-24", "node-26"],
			"credentials": [],
			"artifacts": ["server-manifest"],
			"gate": "blocking",
			"comparison": "provenance",
			"changeImpact": [
				"packages/node/package.json",
				"server.json",
				"packages/node/server.json",
				"plugin.json"
			],
			"nxTarget": "check:server-manifest",
			"mappingStatus": "mapped"
		},
		{
			"id": "docker",
			"external": true,
			"selector": {
				"kind": "docker-smoke"
			},
			"runtimes": ["node-24"],
			"credentials": [],
			"artifacts": ["docker-image"],
			"gate": "blocking",
			"comparison": "candidate-artifact",
			"changeImpact": ["Dockerfile", "packages/node/**"],
			"integration": "docker workflow",
			"nxTarget": null,
			"mappingStatus": "external"
		},
		{
			"id": "generation",
			"alias": "check:generated",
			"selector": {
				"kind": "generated-output-closure"
			},
			"runtimes": ["node-24", "node-26"],
			"credentials": [],
			"artifacts": ["generated-client"],
			"gate": "blocking",
			"comparison": "clean-diff",
			"changeImpact": [
				"openapi-spec.json",
				"packages/hevy-client/src/**",
				"packages/hevy-client/kubb.config.ts"
			],
			"nxTarget": "check:generated",
			"mappingStatus": "mapped"
		},
		{
			"id": "integration-live",
			"alias": "test:live",
			"selector": {
				"kind": "vitest-live"
			},
			"runtimes": ["node-24"],
			"credentials": ["HEVY_API_KEY"],
			"artifacts": ["live-diagnostics"],
			"gate": "release",
			"comparison": "provider-contract",
			"changeImpact": ["packages/**", "tests/integration/**"],
			"nxTarget": "test:live",
			"mappingStatus": "mapped"
		},
		{
			"id": "worker-http-live",
			"alias": "test:worker-http:live",
			"selector": {
				"kind": "worker-live"
			},
			"runtimes": ["workerd"],
			"workflowRuntimes": ["node-24"],
			"credentials": ["HEVY_API_KEY", "HEVY_RUN_LIVE_WORKER_TESTS"],
			"artifacts": ["live-worker-diagnostics"],
			"gate": "release",
			"comparison": "provider-contract",
			"changeImpact": [
				"packages/worker/**",
				"tests/integration/worker-http.integration.test.ts"
			],
			"nxTarget": "test:worker-http:live",
			"mappingStatus": "mapped"
		},
		{
			"id": "release-integration",
			"alias": "test:integration",
			"selector": {
				"kind": "vitest-integration",
				"include": ["tests/integration/**"]
			},
			"runtimes": ["node-24"],
			"credentials": ["HEVY_API_KEY"],
			"artifacts": ["live-diagnostics"],
			"gate": "release",
			"comparison": "provider-contract",
			"changeImpact": ["packages/**", "tests/integration/**"],
			"nxTarget": "test:integration",
			"mappingStatus": "mapped"
		},
		{
			"id": "nightly",
			"alias": "test:nightly",
			"selector": {
				"kind": "launcher-canary"
			},
			"runtimes": ["node-24"],
			"credentials": ["HEVY_API_KEY", "HEVY_MCP_COMMAND", "HEVY_MCP_ARGS_JSON"],
			"artifacts": ["nightly-diagnostics"],
			"gate": "nightly",
			"comparison": "published-launchers",
			"changeImpact": [
				"packages/node/**",
				"tests/nightly/**",
				".github/workflows/nightly-mcp-test.yml"
			],
			"nxTarget": "test:nightly",
			"mappingStatus": "mapped"
		},
		{
			"id": "diagnostics",
			"nxTarget": "test:diagnostics",
			"mappingStatus": "mapped",
			"selector": {
				"kind": "node-test",
				"include": ["tests/nightly/diagnostics.test.mjs"]
			},
			"runtimes": ["node-24"],
			"credentials": [],
			"artifacts": ["nightly-diagnostics"],
			"gate": "blocking",
			"comparison": "diagnostics",
			"changeImpact": ["tests/nightly/diagnostics.test.mjs", "scripts/**"]
		}
	],
	"aggregates": {
		"pull-request": {
			"lanes": [
				"unit",
				"mocked-mcp",
				"contract",
				"stdio",
				"worker",
				"worker-http",
				"pack",
				"cli",
				"pack-cli"
			],
			"nxTarget": "test:pr",
			"mappingStatus": "mapped"
		},
		"pull-request-ci": {
			"external": true,
			"lanes": [
				"repository-control-plane",
				"workspace-topology",
				"package-boundaries",
				"package-exports",
				"release-candidates",
				"types",
				"server-manifest",
				"check",
				"package-changesets",
				"diagnostics",
				"build",
				"worker-http",
				"mocked-mcp",
				"unit",
				"contract",
				"stdio",
				"pack",
				"worker-bundle",
				"performance"
			],
			"integration": "github-actions",
			"nxTarget": null,
			"mappingStatus": "external"
		},
		"release": {
			"lanes": [
				"build",
				"release-unit",
				"pack",
				"release-integration",
				"nightly",
				"worker-http-live"
			],
			"workflowRuntimes": {
				"build": ["node-24"],
				"release-unit": ["node-24"]
			},
			"nxTarget": "release:validate",
			"mappingStatus": "mapped"
		},
		"pre-push": {
			"lanes": ["types", "changeset-status", "pull-request"],
			"nxTarget": "pre-push",
			"mappingStatus": "mapped"
		}
	},
	"unresolvedMappings": []
}
