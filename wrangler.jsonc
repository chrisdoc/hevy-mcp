{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "hevy-mcp",
	"main": "packages/worker/src/worker.ts",
	"compatibility_date": "2026-07-11",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"workers_dev": true,
	"preview_urls": true,
	"observability": {
		"enabled": true,
	},
	"env": {
		"production": {
			"name": "hevy-mcp",
			"workers_dev": false,
			"preview_urls": true,
			"routes": [{ "pattern": "mcp.hevy-mcp.dev", "custom_domain": true }],
			"kv_namespaces": [
				{
					"binding": "OAUTH_KV",
					"id": "4650aad553c0490ab50dbda88a70a7ec",
				},
			],
			"observability": {
				"enabled": true,
				"traces": {
					"enabled": true,
					"destinations": ["otel"],
				},
				"logs": {
					"enabled": true,
					"destinations": ["otel-logs"],
				},
			},
		},
		"preview": {
			"workers_dev": false,
			"preview_urls": true,
			"kv_namespaces": [
				{
					"binding": "OAUTH_KV",
					"id": "df9f8c9c29254712bb75808adb84a447",
				},
			],
			"vars": {
				"MCP_DISABLE_ORIGIN_CHECK": "true",
			},
			"observability": {
				"enabled": true,
				"traces": {
					"enabled": true,
					"destinations": ["otel"],
				},
				"logs": {
					"enabled": true,
					"destinations": ["otel-logs"],
				},
			},
			// This Worker is only a container for PR version aliases. Deliberately
			// do not add routes or custom domains here: production is `hevy-mcp`.
		},
	},
}
