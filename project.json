{
	"$schema": "./node_modules/nx/schemas/project-schema.json",
	"name": "repository",
	"root": ".",
	"projectType": "library",
	"tags": ["runtime:neutral", "publishability:private", "role:control-plane"],
	"targets": {
		"check:control-plane": {
			"cache": true,
			"inputs": ["controlPlaneInputs"]
		},
		"check:generated": {
			"cache": true,
			"inputs": ["generatedClientInputs"]
		},
		"check:openapi": {
			"cache": true,
			"inputs": ["openapiCheckInputs"]
		},
		"check:boundaries": {
			"cache": true,
			"inputs": ["boundaryInputs", "controlPlaneInputs"]
		},
		"check:exports": {
			"executor": "nx:run-commands",
			"cache": true,
			"options": {
				"command": "node scripts/check-package-exports.mjs"
			},
			"inputs": ["packageManifestInputs", "controlPlaneInputs"]
		},
		"check:publint": {
			"executor": "nx:run-commands",
			"cache": false,
			"dependsOn": ["pack:artifacts"],
			"options": {
				"command": "mise exec -- node scripts/check-candidate-publint.mjs"
			},
			"inputs": ["validationInputs"]
		},
		"check:package-changesets": {
			"executor": "nx:run-commands",
			"options": {
				"command": "node scripts/check-package-changesets.mjs"
			},
			"cache": false,
			"inputs": ["packageManifestInputs", "{workspaceRoot}/.changeset/**/*.md"]
		},
		"check:types": {
			"inputs": ["repositoryTypeCheckInputs"]
		},
		"check": {
			"cache": false,
			"inputs": ["validationInputs"]
		},
		"check:server-manifest": {
			"cache": true,
			"inputs": ["manifestInputs"]
		},
		"check:changeset": {
			"cache": false,
			"inputs": ["packageManifestInputs", "{workspaceRoot}/.changeset/**/*.md"]
		},
		"test:pr": {
			"executor": "nx:noop",
			"dependsOn": [
				"test:unit",
				"test:mcp",
				"test:contract",
				"test:stdio",
				"test:worker",
				"test:worker-http",
				"test:pack",
				"test:cli",
				"test:pack:cli",
				"check:publint"
			],
			"inputs": ["validationInputs"]
		},
		"test:unit": {
			"cache": true,
			"inputs": ["unitTests", { "env": "HEVY_TEST_REPORT_MODE" }],
			"outputs": [
				"{workspaceRoot}/coverage/unit",
				"{workspaceRoot}/test-results/unit-tests.xml"
			]
		},
		"test:release-unit": {
			"cache": true,
			"inputs": ["releaseUnitTests"]
		},
		"test:mcp": {
			"cache": true,
			"inputs": ["mockedTests", { "env": "HEVY_TEST_REPORT_MODE" }],
			"outputs": ["{workspaceRoot}/coverage/mocked"]
		},
		"test:integration": {
			"cache": false,
			"inputs": ["validationInputs"]
		},
		"test:diagnostics": {
			"cache": false,
			"inputs": ["validationInputs"]
		},
		"test:contract": {
			"cache": true,
			"inputs": ["contractTests"]
		},
		"test:stdio": {
			"cache": true,
			"inputs": ["stdioTests"],
			"outputs": ["{workspaceRoot}/test-results/stdio"]
		},
		"test:worker": {
			"cache": true,
			"parallelism": false,
			"inputs": ["workerTests"]
		},
		"test:worker-http": {
			"cache": false,
			"inputs": ["validationInputs"]
		},
		"test:pack": {
			"executor": "nx:run-commands",
			"cache": false,
			"dependsOn": ["pack:artifacts"],
			"options": {
				"command": "mise exec -- node tests/package/npm-pack-smoke.mjs"
			},
			"inputs": ["validationInputs"]
		},
		"test:cli": {
			"cache": true,
			"inputs": ["cliTests"]
		},
		"test:pack:cli": {
			"executor": "nx:run-commands",
			"cache": false,
			"dependsOn": ["pack:artifacts"],
			"options": {
				"command": "cross-env FORCE_COLOR=0 mise exec -- node packages/cli/tests/npm-pack-smoke.mjs"
			},
			"inputs": ["validationInputs"]
		},
		"test:nightly": {
			"cache": false,
			"inputs": ["validationInputs"],
			"outputs": ["{workspaceRoot}/test-results/nightly-*.json"]
		},
		"test:live": {
			"cache": false,
			"inputs": ["validationInputs"],
			"outputs": ["{workspaceRoot}/test-results/release-source.json"]
		},
		"test:worker-http:live": {
			"cache": false,
			"inputs": ["validationInputs"],
			"outputs": ["{workspaceRoot}/test-results/worker-http-live"]
		},
		"measure:tokens": {
			"cache": false,
			"inputs": ["validationInputs"]
		},
		"worker:dry-run": {
			"cache": false,
			"inputs": ["validationInputs"],
			"outputs": ["{workspaceRoot}/.wrangler/dry-run"]
		},
		"build": {
			"cache": false,
			"outputs": ["{workspaceRoot}/packages/node/dist"],
			"inputs": ["repositoryNodeBuildInputs"]
		},
		"build:client": {
			"cache": true,
			"outputs": ["{workspaceRoot}/packages/hevy-client/src/generated"],
			"inputs": ["clientGenerationInputs"]
		},
		"release:validate": {
			"executor": "nx:noop",
			"dependsOn": [
				"build",
				"check:server-manifest",
				"test:release-unit",
				"test:worker",
				"test:pack",
				"test:cli",
				"test:pack:cli",
				"check:publint",
				"test:integration",
				"test:nightly",
				"test:worker-http:live"
			],
			"inputs": ["validationInputs"]
		},
		"pre-push": {
			"executor": "nx:noop",
			"dependsOn": ["check:types", "check:changeset", "test:pr"],
			"inputs": ["validationInputs"]
		},
		"sync:server-manifest": {
			"executor": "nx:run-commands",
			"options": {
				"command": "node scripts/server-manifest.mjs sync"
			},
			"cache": false,
			"outputs": [
				"{workspaceRoot}/server.json",
				"{workspaceRoot}/plugin.json",
				"{workspaceRoot}/packages/node/server.json"
			],
			"inputs": ["manifestInputs"]
		},
		"test:performance": {
			"executor": "nx:run-commands",
			"cache": false,
			"dependsOn": ["build"],
			"options": {
				"command": "mise exec -- vitest run tests/performance/performance.test.ts"
			},
			"outputs": ["{workspaceRoot}/test-results/performance/summary.json"],
			"inputs": ["validationInputs"]
		},
		"pack:artifacts": {
			"executor": "nx:run-commands",
			"cache": false,
			"dependsOn": [
				"build",
				"@chrisdoc/hevy-cli:build",
				"check:server-manifest"
			],
			"options": {
				"command": "mise exec -- node scripts/pack-release-candidates.mjs"
			},
			"outputs": [
				"{workspaceRoot}/packages/node/dist",
				"{workspaceRoot}/packages/cli/dist",
				"{workspaceRoot}/.nx/pack/*.tgz"
			],
			"inputs": ["validationInputs"]
		},
		"version:changesets": {
			"executor": "nx:run-commands",
			"options": {
				"command": "changeset version && node scripts/server-manifest.mjs sync"
			},
			"cache": false,
			"inputs": ["packageManifestInputs", "{workspaceRoot}/.changeset/**/*.md"]
		},
		"version": {
			"cache": false,
			"inputs": ["packageManifestInputs", "controlPlaneInputs"]
		},
		"release": {
			"executor": "nx:run-commands",
			"options": {
				"command": "changeset publish"
			},
			"cache": false,
			"inputs": ["packageManifestInputs", "controlPlaneInputs"]
		},
		"worker:deploy": {
			"executor": "nx:run-commands",
			"options": {
				"command": "cross-env WRANGLER_MODE=production wrangler deploy --x-new-config --env production"
			},
			"cache": false,
			"inputs": ["validationInputs"]
		},
		"control-plane": {
			"executor": "nx:noop",
			"dependsOn": [
				"check:control-plane",
				"check:boundaries",
				"check:exports",
				"test:pr",
				"check:server-manifest",
				"check",
				"check:types",
				"check:changeset"
			],
			"inputs": ["validationInputs"]
		}
	}
}
